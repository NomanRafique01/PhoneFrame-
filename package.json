{
  "name": "phoneframe",
  "version": "0.1.2",
  "description": "Floating phone-frame screen mirroring for Android app developers.",
  "author": "Noman Rafique",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "build:icons": "powershell -ExecutionPolicy Bypass -File scripts/build-icons.ps1",
    "start": "electron .",
    "start:build": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.phoneframe.app",
    "productName": "PhoneFrame",
    "artifactName": "PhoneFrame-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "assets/phoneframe-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhoneFrame",
      "installerIcon": "assets/phoneframe-icon.ico",
      "uninstallerIcon": "assets/phoneframe-icon.ico",
      "include": "scripts/installer.nsh"
    }
  }
}
